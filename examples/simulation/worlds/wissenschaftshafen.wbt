Husky {
  translation 10 0 0.255
  rotation 0 0 -1 1.5708
  name "husky"
  controller "<extern>"
  extensionSlot [
    Camera {
      translation 0.32 0 0.25
      name "camera"
      fieldOfView 1.047
      width 640
      height 480
      recognition Recognition {
      }
    }
    RangeFinder {
      translation 0.32 0 0.23
      name "depth"
      fieldOfView 1.047
      width 640
      height 480
      minRange 0.1
      maxRange 10
    }
