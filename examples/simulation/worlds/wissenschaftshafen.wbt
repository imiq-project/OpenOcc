WorldInfo {
  info [
    "IMIQ OCC — Magdeburg Wissenschaftshafen simulation"
    "Clearpath Husky robot with camera, depth, GPS, IMU, gyro"
  ]
  title "Wissenschaftshafen"
  gpsCoordinateSystem "WGS84"
  gpsReference 52.144 11.654 0
  lineScale 4
  basicTimeStep 10
}
Viewpoint {
  orientation -0.25 0.04 0.97 3.7
  position 20 -10 12
  near 0.5
  follow "husky"
  followType "None"
}
TexturedBackground {
}
TexturedBackgroundLight {
}
Floor {
  translation 0 0 -0.02
  size 500 500
  appearance PBRAppearance {
    baseColorMap ImageTexture {
      url [
        "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/default/worlds/textures/grass.jpg"
      ]
    }
    roughness 1
    metalness 0
  }
}
